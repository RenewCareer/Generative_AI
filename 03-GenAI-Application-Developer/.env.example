# Copy to .env in this folder. Never commit .env.
#
# LLM_PROVIDER: openai | anthropic | mock
# Leave it blank to auto-detect: OpenAI key -> Anthropic key -> mock.
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Module 05 (multimodal) models
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Modules 06 and 08 (backend services)
SERVICE_API_KEYS=dev-key-123
